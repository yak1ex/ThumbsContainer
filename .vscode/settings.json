{
  "svelte.enable-ts-plugin": true,
  "chat.tools.terminal.autoApprove": {
    "cargo check": true,
    "npm run check": true,
    "/^\\$roots = @\\(\\$env:APPDATA, \\$env:LOCALAPPDATA\\); foreach \\(\\$r in \\$roots\\) \\{ if \\(Test-Path \\$r\\) \\{ Get-ChildItem -Path \\$r -Filter thumbscontainer\\.db -Recurse -ErrorAction SilentlyContinue \\| Select-Object -First 5 FullName \\} \\}$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "cargo test": true,
    "npm run build": true
  }
}
